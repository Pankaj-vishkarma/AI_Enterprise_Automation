DATABASE_URL=postgresql://user:password@localhost:5432/ai_enterprise_platform

SECRET_KEY=your-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REDIS_URL=

GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/v1
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_SECONDS=30

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_WORKER_BATCH_LIMIT=200
EMBEDDING_WORKER_POLL_INTERVAL_SECONDS=2
EMBEDDING_WORKER_IDLE_SLEEP_SECONDS=0.5

STORAGE_ROOT=./uploads

HTTP_CLIENT_TIMEOUT_SECONDS=15
SLACK_API_URL=https://slack.com/api

# Omnichannel — Slack (replace dummy values with real credentials)
SLACK_BOT_TOKEN=dummy_slack_bot_token
SLACK_SIGNING_SECRET=dummy_slack_signing_secret

# Omnichannel — Telegram (replace dummy values with real credentials)
TELEGRAM_BOT_TOKEN=dummy_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=dummy_telegram_webhook_secret

# Organization id used to route unsigned provider webhooks into the inbox
OMNICHANNEL_WEBHOOK_ORG_ID=1

# Optional — not used by the app today; reserved for future providers
# OPENROUTER_API_KEY=
